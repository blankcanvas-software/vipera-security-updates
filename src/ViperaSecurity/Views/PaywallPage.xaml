<UserControl
    x:Class="ViperaSecurity.Views.PaywallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">

            <!-- Active Subscription & Expiry Info Card -->
            <Border Style="{StaticResource GlowingCard}" Margin="0,0,0,24" Visibility="{Binding IsPremium, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="👑 VIPERA PRO ACTIVE" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource EmeraldPrimary}"/>
                            <Border CornerRadius="4" Background="{StaticResource EmeraldBadgeBg}" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE PLAN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EmeraldPrimary}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding DaysRemainingText, StringFormat='Subscription Status: Active ({0})'}" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="Your device is fully protected by Cloud AI Threat Intelligence &amp; 24/7 Shield." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#162032" CornerRadius="8" Padding="18,12" BorderThickness="1" BorderBrush="#334155" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📅 SUBSCRIPTION EXPIRY DATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding FormattedExpiryDate}" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource EmeraldPrimary}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Hero Pro Plan Card -->
            <Border Style="{StaticResource DarkCard}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="👑 VIPERA PRO EDITION" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource EmeraldPrimary}"/>
                            <Border CornerRadius="4" Background="{StaticResource EmeraldBadgeBg}" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BEST VALUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EmeraldPrimary}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Unlock Cloud AI Threat Intelligence, Google Safe Browsing, and Automated Background Scanning." FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="€39" FontSize="36" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text=" EUR / year" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                            <TextBlock Text=" (€3.25/mo equivalent)" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Content="💳 Subscribe via Stripe (€39/yr)" Command="{Binding SubscribeStripeCommand}" Style="{StaticResource PrimaryButton}" Padding="20,14" FontSize="15"/>
                        <TextBlock Text="🔒 256-bit Encrypted Stripe Checkout" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- License Key Activation Box -->
            <Border Style="{StaticResource DarkCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="🔑 Already Have a License Key or Subscription?" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="Enter your Vipera Pro License Key or order receipt token to activate across all your Windows devices." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" Background="#1E293B" Foreground="{StaticResource TextPrimary}" BorderThickness="1" BorderBrush="#334155" FontSize="14"/>
                        <Button Grid.Column="2" Content="Activate Pro Key" Command="{Binding ActivateKeyCommand}" Style="{StaticResource SecondaryGlassButton}"/>
                    </Grid>

                    <TextBlock Text="{Binding ActivationMessage}" Foreground="{StaticResource EmeraldPrimary}" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Feature Comparison Table -->
            <Border Style="{StaticResource DarkCard}">
                <StackPanel>
                    <TextBlock Text="⚖️ Free vs Pro Feature Comparison" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <TextBlock Text="FEATURE" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                        <TextBlock Text="FREE EDITION" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="PRO EDITION (€39/YR)" FontWeight="Bold" Foreground="{StaticResource EmeraldPrimary}" FontSize="12" HorizontalAlignment="Center"/>
                    </UniformGrid>

                    <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,3">
                        <UniformGrid Columns="3">
                            <TextBlock Text="Quick &amp; Full System Malware Scan" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                            <TextBlock Text="✓ Included" Foreground="{StaticResource TextSecondary}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="✓ Included" Foreground="{StaticResource EmeraldPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </UniformGrid>
                    </Border>

                    <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,3">
                        <UniformGrid Columns="3">
                            <TextBlock Text="Local Web &amp; DNS Domain Blocklist" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                            <TextBlock Text="✓ Included" Foreground="{StaticResource TextSecondary}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="✓ Included" Foreground="{StaticResource EmeraldPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </UniformGrid>
                    </Border>

                    <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,3">
                        <UniformGrid Columns="3">
                            <TextBlock Text="Cloud AI Threat Intelligence (OTX + MetaDefender)" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                            <TextBlock Text="❌ Excluded" Foreground="{StaticResource TextMuted}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="✓ Live Cloud AI" Foreground="{StaticResource EmeraldPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </UniformGrid>
                    </Border>

                    <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,3">
                        <UniformGrid Columns="3">
                            <TextBlock Text="Google Safe Browsing URL Lookup" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                            <TextBlock Text="❌ Excluded" Foreground="{StaticResource TextMuted}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="✓ Live API" Foreground="{StaticResource EmeraldPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </UniformGrid>
                    </Border>

                    <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,3">
                        <UniformGrid Columns="3">
                            <TextBlock Text="Automated Background Scan Scheduler" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                            <TextBlock Text="❌ Excluded" Foreground="{StaticResource TextMuted}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="✓ Included" Foreground="{StaticResource EmeraldPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
