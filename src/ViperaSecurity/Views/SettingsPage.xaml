<UserControl
    x:Class="ViperaSecurity.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <!-- General Settings Card -->
            <Border Style="{StaticResource DarkCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="⚙️ Application Preferences" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Language / Langue / Sprache" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" Padding="10,8" Background="#1E293B" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Automatic Scan Schedule" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AutoScanOptions}" SelectedItem="{Binding SelectedAutoScanSchedule}" Padding="10,8" Background="#1E293B" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding IsAutoScanEnabled}" Content="Enable Automatic Background Threat Scan (Every 1 Hour)" Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,10"/>
                    <CheckBox IsChecked="{Binding IsAutoUpdateOnStartupEnabled}" Content="Automatically Check &amp; Apply Server Updates on Startup" Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,10"/>
                    <CheckBox IsChecked="{Binding IsWebProtectionEnabled}" Content="Enable Real-Time Web &amp; DNS Domain Filtering" Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,10"/>
                    <CheckBox IsChecked="{Binding IsRealTimeShieldEnabled}" Content="Enable Real-Time File System Background Shield" Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,16"/>

                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,4,0,0"/>

                    <TextBlock Text="{Binding SaveMessage}" Foreground="{StaticResource EmeraldPrimary}" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- In-App Server Auto-Updater Card -->
            <Border Style="{StaticResource GlowingCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🚀 In-App Server Auto-Updater" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Check for over-the-air updates from server without downloading installer manually." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" CornerRadius="6" Background="#1E293B" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersionText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource EmeraldPrimary}"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="8" Foreground="{StaticResource EmeraldPrimary}" Background="#1E293B" BorderThickness="0" Margin="0,0,0,14" Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource SecondaryGlassButton}" Margin="0,0,10,0"/>
                        <Button Content="⚡ Apply Update Now" Command="{Binding ApplyUpdateCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
